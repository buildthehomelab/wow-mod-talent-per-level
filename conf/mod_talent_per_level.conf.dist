#
# mod-talent-per-level configuration
#

#
#    TalentPerLevel.Enable
#        Description: Enable 1 talent point per level from 1–MaxLevel (replaces Blizzard L10 start).
#        Default:     1
#

TalentPerLevel.Enable = 1

#
#    TalentPerLevel.MaxLevel
#        Description: Cap level used for the 1:1 talent curve.
#        Default:     80
#

TalentPerLevel.MaxLevel = 80
